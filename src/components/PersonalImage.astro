---
import { Picture } from 'astro:assets'
import personalImg from '@/assets/images/personal.jpg'
import { getI18N } from '@/features/i18n/'

const { currentLocale: lang } = Astro
const { PORTFOLIO } = await getI18N({ lang })
---

<Picture
  alt={PORTFOLIO.HERO.IMAGE_ALT}
  src={personalImg}
  width={112}
  height={112}
  formats={['webp', 'avif']}
  loading='eager'
  class='relative z-10 mb-4 ml-3 size-28 rounded-full bg-background/20'
/>
