---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js'

interface Props<ListType = {}> {
  list: ListType[]
  Item: AstroComponentFactory
  mode?: 'vertical' | 'landscape'
  wrapperClass?: string
  listClass?: string
  itemClass?: string
  gap?: `${number}px` | `${number}rem`
  delay?: number
  duration?: number
  direction?: 'reverse' | 'alternate' | 'alternate-reverse' | 'normal'
  pauseOnHover?: boolean
}

const {
  list,
  Item,
  mode = 'landscape',
  wrapperClass = '',
  gap = '8px',
  listClass = '',
  itemClass = '',
  delay = 0,
  duration = 10,
  direction = 'normal',
  pauseOnHover = false,
} = Astro.props

const itemsQuantity = list.length
const cssDuration = `${duration}s`
const cssDelay = `${delay}s`
---

<div aria-hidden='true' class:list={[wrapperClass, 'w-fit overflow-hidden']}>
  <ul
    style={`gap: ${gap}`}
    class:list={[
      listClass,
      'card-slides flex items-center',
      mode === 'vertical' && 'flex-col',
      pauseOnHover &&
        'hover:[animation-play-state:paused] group-hover:[animation-play-state:paused]',
    ]}>
    {
      list.map((item) => (
        <li class:list={[itemClass, 'shrink-0']}>
          <Item {...item} />
        </li>
      ))
    }
    {
      list.map((item) => (
        <li class:list={[itemClass, 'shrink-0']}>
          <Item {...item} />
        </li>
      ))
    }
  </ul>
</div>

<style define:vars={{ cssDelay, cssDuration, direction, itemsQuantity, gap }}>
  @keyframes autoSlide {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc((-48px - var(--gap)) * var(--itemsQuantity)));
    }
  }

  .card-slides {
    animation-name: autoSlide;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-direction: var(--direction);
    animation-delay: var(--cssDelay);
    animation-duration: var(--cssDuration);
  }
</style>
