---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js'

interface Props<ListType = {}> {
  list: ListType[]
  Item: AstroComponentFactory
  mode?: 'vertical' | 'landscape'
  wrapperClass?: string
  listClass?: string
  itemClass?: string
  gap?: `${number}px` | `${number}rem`
  delay?: number
  duration?: number
  direction?: 'reverse' | 'alternate' | 'alternate-reverse' | 'normal'
  pauseOnHover?: boolean
}

const {
  list,
  Item,
  mode = 'landscape',
  wrapperClass = '',
  gap = '8px',
  listClass = '',
  itemClass = '',
  delay = '0rem',
  duration = 10,
  direction = 'normal',
  pauseOnHover = false,
} = Astro.props

const itemsQuantity = list.length
const cssDuration = `${duration}s`
const cssDelay = `${delay}s`
---

<div aria-hidden='true' class:list={[wrapperClass, 'group']}>
  <ul
    style={`gap: ${gap};`}
    class:list={[
      listClass,
      'card-slides flex w-max items-center py-4',
      mode === 'vertical' && 'flex-col',
      pauseOnHover && 'group-hover:[animation-play-state:paused]',
    ]}>
    {
      [...Array(3)].map(() =>
        list.map((item) => (
          <li class:list={[itemClass, 'shrink-0']}>
            <Item {...item} />
          </li>
        ))
      )
    }
  </ul>
</div>

<style define:vars={{ cssDelay, cssDuration, direction, itemsQuantity, gap }}>
  @keyframes autoSlide {
    to {
      transform: translate3d(calc(-100% / 3), 0, 0);
    }
  }

  .card-slides {
    animation-name: autoSlide;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-direction: var(--direction);
    animation-delay: var(--cssDelay);
    animation-duration: var(--cssDuration);
  }
</style>
