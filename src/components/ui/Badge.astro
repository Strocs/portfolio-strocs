---
import type { HTMLAttributes } from 'astro/types'

type Variants = 'default' | 'lg'

interface IconProps {
  class?: string
}

interface Props extends HTMLAttributes<'span'> {
  Icon?: (props: IconProps) => astroHTML.JSX.Element
  label: string
  variant?: Variants
  class?: string
}

const {
  Icon = null,
  label,
  variant = 'default',
  class: customClass,
} = Astro.props

const variants: Record<Variants, string> = {
  lg: 'py-2 px-6',
  default: 'py-1 px-4',
}
---

<span
  class:list={[
    'flex size-min items-center gap-2 rounded font-azeret text-sm leading-none font-light whitespace-nowrap text-foreground outline outline-1 outline-foreground/20',
    variants[variant],
    customClass,
  ]}>
  {!!Icon && <Icon class='size-4' />}
  {label}
</span>

<style>
  .shadow-light {
    box-shadow: 0 0 2rem 0 oklch(28% 0.01 250);
  }
</style>
