---
import type { HTMLAttributes } from 'astro/types'

type Variants = 'default' | 'lg' | 'xl'
type HeadingTag = 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6'

interface Props extends HTMLAttributes<'h1'> {
  variant?: Variants
  as: HeadingTag
  class?: string
  content: string
  id?: string
}

const {
  variant = 'default',
  as: Tag = 'h2',
  class: customClass,
  content,
  id,
  ...props
} = Astro.props

const variants: Record<Variants, string> = {
  default: 'text-xl font-sans font-bold',
  lg: 'text-2xl font-azeret font-bold',
  xl: 'text-5xl leading-tight font-azeret ',
}
---

<Tag
  {id}
  class:list={['text-foreground', variants[variant], customClass]}
  {...props}
  set:html={content}
/>
