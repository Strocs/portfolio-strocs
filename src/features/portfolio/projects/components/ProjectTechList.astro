---
import Badge from '@/components/ui/Badge.astro'

interface Props {
  stack?: string[]
}

const { stack = [] } = Astro.props
---

{
  stack.length > 0 && (
    <ul class='flex flex-wrap gap-4'>
      {stack.map((tech) => (
        <li>
          <Badge label={tech} />
        </li>
      ))}
    </ul>
  )
}
