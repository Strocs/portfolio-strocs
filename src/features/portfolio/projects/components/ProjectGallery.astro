---
import type { PersonalProjectsSchema } from '@/features/content/schemas'
import type { z } from 'astro:content'

type Props = Pick<z.infer<typeof PersonalProjectsSchema>, 'images'>

const { images = [] } = Astro.props
---

<figure class='flex gap-10'>
  {
    images.map((image, index) => (
      <div class='h-60 w-full max-w-[420px] shrink-0 rounded-md bg-[#272729]' />
    ))
  }
</figure>
