---
import Indicator from '@/components/ui/Indicator.astro'
import Paragraph from '@/components/ui/Paragraph.astro'
import Title from '@/components/ui/Title.astro'
import { getI18N } from '@/i18n'
import ContactLinks from '../hero/components/ContactLinks.astro'
import StackSlides from './components/StackSlides.astro'
import StackItem from './components/StackItem.astro'

const { currentLocale: lang } = Astro
const { PORTFOLIO } = await getI18N({ lang })
const { ABOUT } = PORTFOLIO

const stacks = [
  { title: 'Javascript', icon: '' },
  { title: 'Typescript', icon: '' },
  { title: 'Python', icon: '' },
  { title: 'Java', icon: '' },
]
---

<section class='flex gap-4'>
  <article class='shrink-0'>
    <header class='flex items-center'>
      <Indicator />
      <Title variant='lg' as='h2' content={ABOUT?.TITLE ?? ''} />
    </header>
    <Paragraph content={ABOUT?.DESCRIPTION ?? ''} />
    <ContactLinks />
  </article>
  <aside class=''>
    <StackSlides list={stacks} Item={StackItem} mode='vertical' />
  </aside>
</section>

<style></style>
