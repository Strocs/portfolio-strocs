---
import { getIconByName } from '../utils/getIconByName'

interface Props {
  tech: string
}

const { tech = '' } = Astro.props

const Icon = getIconByName(tech)
---

<div class='text-background'>
  <Icon
    class='size-12 opacity-25 grayscale transition-[opacity,filter] duration-150 hover:opacity-100 hover:grayscale-0'
  />
</div>
