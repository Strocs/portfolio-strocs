---
import AutoSlides from '@/components/AutoSlides.astro'
import StackItem from './components/StackItem.astro'
import { stack } from './data/stack.data.ts'
---

<AutoSlides
  list={stack}
  Item={StackItem}
  wrapperClass='absolute rotate-12 -left-8 top-48 bg-background/20 outline-1 outline outline-foreground/20'
  pauseOnHover
  gap='1rem'
/>
