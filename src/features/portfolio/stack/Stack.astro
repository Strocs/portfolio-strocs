---
import AutoSlides from '@/components/AutoSlides.astro'
import StackItem from './components/StackItem.astro'
import { stack } from './data/stack.data.ts'
---

<AutoSlides
  list={stack}
  Item={StackItem}
  wrapperClass='w-[110vw] absolute -left-[5vw] top-48 rotate-12 bg-background/20 outline-1 outline outline-foreground/20'
  pauseOnHover
  duration={20}
  gap='1rem'
/>
