---
import Layout from '@/layouts/Layout.astro'
import Nav from '@/features/portfolio/nav/Nav.astro'
import Hero from '@/features/portfolio/hero/Hero.astro'
import Experience from '@/features/portfolio/experience/Experience.astro'
import Projects from '@/features/portfolio/projects/Projects.astro'
import About from '@/features/portfolio/about/About.astro'
import Stack from '@/features/portfolio/stack/Stack.astro'
import Footer from '@/components/Footer.astro'
import { getI18N } from '@/features/i18n/'

const { currentLocale: lang } = Astro
const { SEO_TITLE, SEO_DESCRIPTION, NAV } = await getI18N({ lang })
---

<Layout title={SEO_TITLE} description={SEO_DESCRIPTION}>
  <!-- Blog navigation link -->
  <a
    href='/blog'
    aria-label={NAV.BLOG}
    class='fixed top-0 right-0 bottom-0 z-50 m-auto h-[98vh] w-16 translate-x-10 transform-gpu rounded-l-3xl bg-background py-16 opacity-50 shadow-[0_0_0] ring-1 shadow-foreground ring-foreground/20 transition duration-200 hover:translate-x-0 hover:opacity-100 focus:translate-x-0 focus:opacity-100'>
    <span class='sr-only'>{NAV.BLOG}</span>
  </a>

  <!-- Decorative tech stack background -->
  <Stack />

  <div class='grid w-full grid-cols-[628px_auto]'>
    <aside class='block w-full'>
      <Nav />
    </aside>
    <main id='main-content' class='grid w-full gap-52'>
      <Hero />
      <section id='experience' aria-labelledby='experience-heading'>
        <Experience />
      </section>
      <section id='projects' aria-labelledby='projects-heading'>
        <Projects />
      </section>
      <section id='about' aria-labelledby='about-heading'>
        <About />
      </section>
    </main>
  </div>
  <Footer />
</Layout>
