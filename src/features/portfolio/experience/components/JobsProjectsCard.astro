---
import Title from '@/components/ui/Title.astro'
import TitleLink from '@/components/ui/TitleLink.astro'
import Status from '@/components/ui/Status.astro'
import Github from '@/assets/icons/github.svg'
import Paragraph from '@/components/ui/Paragraph.astro'
import Button from '@/components/ui/Button.astro'
import { getI18N } from '@/features/i18n/'
import type { ExperienceProjectsCollection } from '../types'

type Props = ExperienceProjectsCollection

const { currentLocale: lang } = Astro
const { SEE_MORE_BTN, A11Y } = await getI18N({ lang })

const { data: jobData, id } = Astro.props
---

<article
  class='grid h-60 w-full max-w-[420px] grid-rows-[fit-content(100%)_auto_fit-content(100%)] gap-2 rounded-lg px-6 pt-4 pb-6 text-foreground outline-1 outline-foreground/20 transition duration-150 focus-within:bg-background/20 hover:bg-background/20'>
  <header class='flex size-fit items-center gap-4'>
    <div class='flex items-center gap-2'>
      <Status active={jobData.active} />
      {
        jobData.active ? (
          <TitleLink
            target='_blank'
            rel='noopener noreferrer'
            href={jobData.url.live}
            class='hover:underline'>
            <Title as='h4' content={jobData.title} />
          </TitleLink>
        ) : (
          <Title as='h4' content={jobData.title} />
        )
      }
    </div>
    {
      jobData.url.github && (
        <a
          href={jobData.url.github}
          target='_blank'
          rel='noopener noreferrer'
          aria-label={`${A11Y.REPOSITORY_LINK}: ${jobData.title}`}
          class='rounded hover:scale-105 focus:scale-105 focus:outline-none focus-visible:ring-2 focus-visible:ring-foreground'>
          <Github class='size-5 text-foreground' />
        </a>
      )
    }
  </header>
  <Paragraph content={jobData.extract} class='leading-tight' />
  <Button as='a' href={'/blog/' + id}>{SEE_MORE_BTN}</Button>
</article>
