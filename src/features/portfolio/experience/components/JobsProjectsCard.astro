---
import Title from '@/components/ui/Title.astro'
import TitleLink from '@/components/ui/TitleLink.astro'
import Status from '@/components/ui/Status.astro'
import Github from '@/assets/icons/github.svg'
import Paragraph from '@/components/ui/Paragraph.astro'
import Button from '@/components/ui/Button.astro'
import { getI18N } from '@/features/i18n/'
import type { ExperienceProjectsCollection } from '../types'

type Props = ExperienceProjectsCollection

const { currentLocale: lang } = Astro
const { SEE_MORE_BTN } = await getI18N({ lang })

const { data: jobData, id } = Astro.props
---

<article
  class='text-foreground outline-foreground/20 hover:bg-background/20 grid h-60 w-full max-w-[420px] grid-rows-[fit-content(100%)_auto_fit-content(100%)] gap-2 rounded-lg px-6 pt-4 pb-6 outline-1 transition duration-150'>
  <header class='flex size-fit items-center gap-4'>
    <div class='flex items-center gap-2'>
      <Status active={jobData.active} />
      {
        jobData.active ? (
          <TitleLink
            target='_blank'
            href={jobData.url.github}
            class='hover:underline'>
            <Title as='h3' content={jobData.title} />
          </TitleLink>
        ) : (
          <Title as='h3' content={jobData.title} />
        )
      }
    </div>
    {
      jobData.url.github && (
        <a
          href={jobData.url.github}
          target='_blank'
          aria-label='Repository Link'
          class='hover:scale-105'>
          <Github class='text-foreground size-5' />
        </a>
      )
    }
  </header>
  <Paragraph content={jobData.extract} class='leading-tight' />
  <Button as='a' href={'/blog/' + id} class=''>{SEE_MORE_BTN}</Button>
</article>
